    },
    {
      "id": "u7GX4wW8QRtVMG2_AVok4",
      "type": "rectangle",
      "x": -438.6280318866302,
      "y": -5890.522707417707,
      "width": 1434,
      "height": 4895.999908447266,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
