      "text": "Queries- The Power of Asking What You Need",
      "fontSize": 17.022848496588267,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Queries- The Power of Asking What You Need",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9Yl3aqL8CX_txza7YlYFV",
      "type": "text",
      "x": 1599.429157121712,
      "y": -3900.0064729791825,
      "width": 722.4794311523438,
      "height": 1420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2J",
      "roundness": null,
      "seed": 1544093013,
      "version": 270,
      "versionNonce": 1102597205,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790336698944,
      "link": null,
      "locked": false,
      "text": "# Mobile app query — gets exactly what it needs, nothing more\nquery MobileUserProfile($userId: ID!) {\n    user(id: $userId) {\n        username\n        profileImage\n        orders(first: 3, status: DELIVERED) { \n#web could ask for the first ten instead i.e \"first: 10\" and they both hit the sam eendpoint\n            edges {\n                node {\n                    id\n                    total\n                    status\n                }\n            }\n        }\n    }\n}\n\n                                        Response   \n{\n    \"data\": {\n        \"user\": {\n            \"username\": \"404\",\n            \"profileImage\": \"https://cdn.example.com/img/123.jpg\",\n            \"orders\": {\n                \"edges\": [\n                    { \"node\": { \"id\": \"ord_1\", \"total\": 59.99, \"status\": \"DELIVERED\" }},\n                    { \"node\": { \"id\": \"ord_2\", \"total\": 129.00, \"status\": \"DELIVERED\" }},\n                    { \"node\": { \"id\": \"ord_3\", \"total\": 29.99, \"status\": \"DELIVERED\" }}\n                ]\n            }\n        }\n    }\n}\n\n                                        Mutations\nmutation PlaceOrder($input: PlaceOrderInput!) {\n    placeOrder(input: $input) {\n        order {\n            id\n            status\n            total\n        }\n        errors {\n            field\n            message\n        }\n    }\n}\n\n                                            Varaibles\n{\n    \"input\": {\n        \"items\": [\n            { \"productId\": \"prod_123\", \"quantity\": 2 },\n            { \"productId\": \"prod_456\", \"quantity\": 1 }\n        ],\n        \"shippingAddressId\": \"addr_789\",\n        \"paymentMethodId\": \"pm_abc\"\n    }\n}\n\n                                            Subscriptions - Real Time\nsubscription OrderUpdates($orderId: ID!) {\n    orderStatusChanged(orderId: $orderId) {\n        id\n        status\n        estimatedDelivery\n    }\n}\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Mobile app query — gets exactly what it needs, nothing more\nquery MobileUserProfile($userId: ID!) {\n    user(id: $userId) {\n        username\n        profileImage\n        orders(first: 3, status: DELIVERED) { \n#web could ask for the first ten instead i.e \"first: 10\" and they both hit the sam eendpoint\n            edges {\n                node {\n                    id\n                    total\n                    status\n                }\n            }\n        }\n    }\n}\n\n                                        Response   \n{\n    \"data\": {\n        \"user\": {\n            \"username\": \"404\",\n            \"profileImage\": \"https://cdn.example.com/img/123.jpg\",\n            \"orders\": {\n                \"edges\": [\n                    { \"node\": { \"id\": \"ord_1\", \"total\": 59.99, \"status\": \"DELIVERED\" }},\n                    { \"node\": { \"id\": \"ord_2\", \"total\": 129.00, \"status\": \"DELIVERED\" }},\n                    { \"node\": { \"id\": \"ord_3\", \"total\": 29.99, \"status\": \"DELIVERED\" }}\n                ]\n            }\n        }\n    }\n}\n\n                                        Mutations\nmutation PlaceOrder($input: PlaceOrderInput!) {\n    placeOrder(input: $input) {\n        order {\n            id\n            status\n            total\n        }\n        errors {\n            field\n            message\n        }\n    }\n}\n\n                                            Varaibles\n{\n    \"input\": {\n        \"items\": [\n            { \"productId\": \"prod_123\", \"quantity\": 2 },\n            { \"productId\": \"prod_456\", \"quantity\": 1 }\n        ],\n        \"shippingAddressId\": \"addr_789\",\n        \"paymentMethodId\": \"pm_abc\"\n    }\n}\n\n                                            Subscriptions - Real Time\nsubscription OrderUpdates($orderId: ID!) {\n    orderStatusChanged(orderId: $orderId) {\n        id\n        status\n        estimatedDelivery\n    }\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
