    {
      "id": "2pNY4HWYcds9MDB5zpZir",
      "type": "text",
      "x": 1859.2889295296357,
      "y": -2054.5308164247026,
      "width": 929.2192993164062,
      "height": 1025,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
