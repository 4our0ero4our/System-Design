      "text": "The Type System\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Type System\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "o5bI-Wl0YmoUVpCsCyNxe",
      "type": "text",
      "x": 1609.0129957982824,
      "y": -5265.930145806943,
      "width": 473.4075927734375,
      "height": 1320,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2G",
      "roundness": null,
      "seed": 411945365,
      "version": 81,
      "versionNonce": 641441077,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790336095052,
      "link": null,
      "locked": false,
      "text": "# The schema is the contract between client and server\n\ntype User {\n    id: ID!                    # ! means non-nullable\n    username: String!\n    email: String!\n    createdAt: DateTime!\n    orders(\n        first: Int             # pagination\n        after: String          # cursor\n        status: OrderStatus    # filtering\n    ): OrderConnection!\n    followers: [User!]!\n    following: [User!]!\n    profileImage: String       # nullable — might not have one\n}\n\ntype Order {\n    id: ID!\n    user: User!\n    items: [OrderItem!]!\n    total: Float!\n    status: OrderStatus!\n    createdAt: DateTime!\n}\n\ntype OrderItem {\n    product: Product!\n    quantity: Int!\n    price: Float!\n}\n\ntype Product {\n    id: ID!\n    name: String!\n    price: Float!\n    category: Category!\n    inventory: Int!\n}\n\nenum OrderStatus {\n    PENDING\n    PROCESSING\n    SHIPPED\n    DELIVERED\n    CANCELLED\n}\n\n# Connection type for cursor-based pagination\ntype OrderConnection {\n    edges: [OrderEdge!]!\n    pageInfo: PageInfo!\n    totalCount: Int!\n}\n\ntype OrderEdge {\n    node: Order!\n    cursor: String!\n}\n\ntype PageInfo {\n    hasNextPage: Boolean!\n    hasPreviousPage: Boolean!\n    startCursor: String\n    endCursor: String\n}",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# The schema is the contract between client and server\n\ntype User {\n    id: ID!                    # ! means non-nullable\n    username: String!\n    email: String!\n    createdAt: DateTime!\n    orders(\n        first: Int             # pagination\n        after: String          # cursor\n        status: OrderStatus    # filtering\n    ): OrderConnection!\n    followers: [User!]!\n    following: [User!]!\n    profileImage: String       # nullable — might not have one\n}\n\ntype Order {\n    id: ID!\n    user: User!\n    items: [OrderItem!]!\n    total: Float!\n    status: OrderStatus!\n    createdAt: DateTime!\n}\n\ntype OrderItem {\n    product: Product!\n    quantity: Int!\n    price: Float!\n}\n\ntype Product {\n    id: ID!\n    name: String!\n    price: Float!\n    category: Category!\n    inventory: Int!\n}\n\nenum OrderStatus {\n    PENDING\n    PROCESSING\n    SHIPPED\n    DELIVERED\n    CANCELLED\n}\n\n# Connection type for cursor-based pagination\ntype OrderConnection {\n    edges: [OrderEdge!]!\n    pageInfo: PageInfo!\n    totalCount: Int!\n}\n\ntype OrderEdge {\n    node: Order!\n    cursor: String!\n}\n\ntype PageInfo {\n    hasNextPage: Boolean!\n    hasPreviousPage: Boolean!\n    startCursor: String\n    endCursor: String\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gEEdSiVKsmFaMXM7vS9y_",
      "type": "text",
      "x": 1737.9298151092241,
      "y": -3929.4133224762036,
      "width": 379.60921626995446,
      "height": 21.278560620735334,
