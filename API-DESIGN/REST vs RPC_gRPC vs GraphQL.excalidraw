    {
      "id": "2tqXAvcsWJiYprpfPbbU4",
      "type": "text",
      "x": 1575.4728070757496,
      "y": -463.4532479156318,
      "width": 145.37594604492188,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
