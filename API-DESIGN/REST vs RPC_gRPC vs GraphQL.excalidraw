    {
      "id": "KuOqUDf0Allibmu3KohZR",
      "type": "text",
      "x": 2427.509088623564,
      "y": -374.227826186208,
      "width": 843.8072509765625,
      "height": 79.99999999999994,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2m",
      "roundness": null,
      "seed": 1166877077,
      "version": 101,
      "versionNonce": 630483509,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790384241309,
      "link": null,
      "locked": false,
      "text": "Facebook built GraphQL internally in 2012 to solve a specific problem: their iOS and Android apps had comp-\nletely different data needs, and their REST API was forcing both to over-fetch massively on slow mobile\nnetworks. They needed a way for clients to specify exactly what they need.\n",
      "fontSize": 15.99999999999999,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Facebook built GraphQL internally in 2012 to solve a specific problem: their iOS and Android apps had comp-\nletely different data needs, and their REST API was forcing both to over-fetch massively on slow mobile\nnetworks. They needed a way for clients to specify exactly what they need.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
