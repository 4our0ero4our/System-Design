      "link": null,
      "locked": false,
      "text": "syntax = \"proto3\";\npackage payments;\n\n// The service definition\nservice PaymentService {\n    // Unary — one request, one response (like REST)\n    rpc ProcessPayment(PaymentRequest) returns (PaymentResponse);\n\n    // Server streaming — one request, stream of responses\n    rpc StreamTransactions(TransactionStreamRequest) returns (stream Transaction);\n\n    // Client streaming — stream of requests, one response\n    rpc BatchUploadPayments(stream PaymentRequest) returns (BatchResponse);\n\n    // Bidirectional streaming — stream of requests AND stream of responses\n    rpc LivePaymentFeed(stream PaymentFilter) returns (stream Transaction);\n}\n\nmessage PaymentRequest {\n    string user_id = 1;\n    double amount = 2;\n    string currency = 3;       // ISO 4217: GBP, USD, EUR\n    string idempotency_key = 4; // prevent duplicate charges\n}\n\nmessage PaymentResponse {\n    string payment_id = 1;\n    PaymentStatus status = 2;\n    google.protobuf.Timestamp processed_at = 3;\n    string failure_reason = 4; // empty on success\n}\n\nenum PaymentStatus {\n    PENDING = 0;\n    SUCCEEDED = 1;\n    FAILED = 2;\n    REFUNDED = 3;\n}\n\nmessage Transaction {\n    string id = 1;\n    string user_id = 2;\n    double amount = 3;\n    string currency = 4;\n    TransactionType type = 5;\n    google.protobuf.Timestamp timestamp = 6;\n}\n\nenum TransactionType {\n    DEBIT = 0;\n    CREDIT = 1;\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "syntax = \"proto3\";\npackage payments;\n\n// The service definition\nservice PaymentService {\n    // Unary — one request, one response (like REST)\n    rpc ProcessPayment(PaymentRequest) returns (PaymentResponse);\n\n    // Server streaming — one request, stream of responses\n    rpc StreamTransactions(TransactionStreamRequest) returns (stream Transaction);\n\n    // Client streaming — stream of requests, one response\n    rpc BatchUploadPayments(stream PaymentRequest) returns (BatchResponse);\n\n    // Bidirectional streaming — stream of requests AND stream of responses\n    rpc LivePaymentFeed(stream PaymentFilter) returns (stream Transaction);\n}\n\nmessage PaymentRequest {\n    string user_id = 1;\n    double amount = 2;\n    string currency = 3;       // ISO 4217: GBP, USD, EUR\n    string idempotency_key = 4; // prevent duplicate charges\n}\n\nmessage PaymentResponse {\n    string payment_id = 1;\n    PaymentStatus status = 2;\n    google.protobuf.Timestamp processed_at = 3;\n    string failure_reason = 4; // empty on success\n}\n\nenum PaymentStatus {\n    PENDING = 0;\n    SUCCEEDED = 1;\n    FAILED = 2;\n    REFUNDED = 3;\n}\n\nmessage Transaction {\n    string id = 1;\n    string user_id = 2;\n    double amount = 3;\n    string currency = 4;\n    TransactionType type = 5;\n    google.protobuf.Timestamp timestamp = 6;\n}\n\nenum TransactionType {\n    DEBIT = 0;\n    CREDIT = 1;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
