    {
      "id": "H-a_F04IrWbJL52--G4QJ",
      "type": "text",
      "x": -424.6280318866302,
      "y": -5867.522707417707,
      "width": 1436.578857421875,
      "height": 4275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
