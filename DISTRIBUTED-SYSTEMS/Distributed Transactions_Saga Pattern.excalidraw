    {
      "id": "TotppDXU1cu50YVdlSHiO",
      "type": "text",
      "x": -384,
      "y": -2396,
      "width": 1449.3389892578125,
      "height": 6050,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
