    {
      "id": "PPaAb5CoupFGjcqeRA6hQ",
      "type": "text",
      "x": 3096.117917190559,
      "y": 181.52461053783543,
      "width": 1722.47900390625,
      "height": 1725,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
